# ---- Supabase (Settings → API) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...      # service_role, NOT anon. Server only.
                                           # Never prefix with NEXT_PUBLIC_.

# ---- Admin gate -------------------------------------------------------------
ADMIN_PASSCODE=                            # what the two admins type
AUTH_SECRET=                               # openssl rand -hex 32   (min 32 chars)

# ---- Email (optional — the app must work fully without these) ---------------
RESEND_API_KEY=re_...
EMAIL_FROM="On Mic Community <tickets@yourdomain.com>"

# ---- SMS auto-verify webhook (optional) --------------------------------------
# Shared secret for POST /api/sms/verify — a phone automation app (MacroDroid,
# Tasker, ...) forwards each incoming bank-credit SMS here, sent as the
# x-sms-secret header (or a "secret" field in the JSON body) alongside the raw
# SMS text. Unset disables the endpoint (it always responds 500).
SMS_WEBHOOK_SECRET=

# ---- Links ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://onmic.vercel.app

# ---- Local development / test harness only ----------------------------------
# Setting DATABASE_URL switches the data layer to a direct Postgres connection
# and the Supabase variables above are then unused. Never set this on Vercel:
# serverless functions and a direct Postgres pool do not mix well on the free
# tier, which is why production talks to Supabase over HTTP.
# DATABASE_URL=postgresql://postgres@127.0.0.1:55432/onmic
